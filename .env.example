# LLM Provider: "gemini" or "bedrock" (defaults to "gemini" if GOOGLE_API_KEY is present)
LLM_PROVIDER=gemini

# Google Gemini API Key (get yours at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-api-key-here

# AWS Bedrock Configuration (if using LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Optional explicit credentials (or use ~/.aws/credentials / AWS SSO / IAM role):
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-aws-session-token
# AWS_PROFILE=default
